// Cloudflare Workers config. Lets Cloudflare build and deploy this repo straight
// from GitHub (Workers & Pages → your Worker → Settings → Builds → Connect).
// Keep "name" equal to your existing Worker so the site address — and the
// collection saved in your browser for that address — stay the same.
{
  "name": "cardforge2",
  "compatibility_date": "2026-10-01",
  // Static files are served directly; worker.js handles cached images and the /api/meta/… routes.
  "main": "worker.js",
  // Daily refresh of Magic tournament data (TopDeck.gg). Add the API key once with:
  //   npx wrangler secret put TOPDECK_KEY   (or Workers → cardforge2 → Settings → Variables and Secrets)
  // Second trigger: record shared price history (needs the SUPABASE_SERVICE_KEY secret).
  "triggers": { "crons": ["17 6 * * *", "41 7 * * *"] },
  // Temporary owner testing mode. Restore "true" before the public launch.
  "vars": { "TCGPLAYER_WEB_TEST": "true", "AI_LIMITS_ENABLED": "false", "CONDITION_OWNER_ID": "94ea20a0-f250-4815-8391-de48dd14df98", "CONDITION_DAILY_LIMIT": "60", "CONDITION_MONTHLY_LIMIT": "900", "CONDITION_MINUTE_LIMIT": "8" },
  "durable_objects": { "bindings": [{ "name": "AI_REVIEW_LIMITS", "class_name": "AiReviewLimits" }, { "name": "CONDITION_PRICES", "class_name": "ConditionPriceCache" }, { "name": "DAILY_CARDS", "class_name": "DailyCards" }] },
  "migrations": [{ "tag": "ai-review-v1", "new_sqlite_classes": ["AiReviewLimits"] }, { "tag": "condition-prices-v1", "new_sqlite_classes": ["ConditionPriceCache"] }, { "tag": "daily-cards-v1", "new_sqlite_classes": ["DailyCards"] }],
  // Branch previews require explicit non-secret settings. Same-Worker Durable
  // Objects get isolated namespaces automatically; never bind production IDs
  // or copy provider/database credentials into a preview.
  "previews": {
    "vars": { "TCGPLAYER_WEB_TEST": "true", "AI_LIMITS_ENABLED": "false", "CONDITION_DAILY_LIMIT": "60", "CONDITION_MONTHLY_LIMIT": "900", "CONDITION_MINUTE_LIMIT": "8" },
    "durable_objects": { "bindings": [{ "name": "AI_REVIEW_LIMITS", "class_name": "AiReviewLimits" }, { "name": "CONDITION_PRICES", "class_name": "ConditionPriceCache" }, { "name": "DAILY_CARDS", "class_name": "DailyCards" }] }
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
}
