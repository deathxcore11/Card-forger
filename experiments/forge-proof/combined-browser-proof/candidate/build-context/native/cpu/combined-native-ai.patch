+package forge.ai;
+
+import forge.StaticData;
+import forge.card.CardStateName;
+import forge.card.ICardFace;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.function.Predicate;
+
+/** Conservative opponent-name choice; assumes SECRET decklists, not a public deck manifest. */
+public final class ObservedCardNames {
+    private ObservedCardNames() { }
+
+    public static String choose(Player viewer, Predicate<ICardFace> allowed, boolean nonlandsOnly) {
+        Map<String,Integer> counts = new TreeMap<>();
+        for (Card card : viewer.getGame().getCardsInGame()) {
+            if (!card.getController().isOpponentOf(viewer)) continue;
+            // Membership/counts may be public, but do not inspect identity/type before checking BOTH permissions.
+            if (!card.getView().canBeShownTo(viewer.getView())
+                    || !card.getView().canFaceDownBeShownTo(viewer.getView())) continue;
+            String name = card.isFaceDown() ? card.getState(CardStateName.Original).getName() : card.getName();
+            ICardFace face = StaticData.instance().getCommonCards().getFaceByName(name);
+            if (face == null || !allowed.test(face) || (nonlandsOnly && face.getType().isLand())) continue;
+            counts.merge(name, 1, Integer::sum);
+        }
+        String best = ""; int count = 0;
+        for (Map.Entry<String,Integer> item : counts.entrySet()) {
+            if (item.getValue() > count) { best = item.getKey(); count = item.getValue(); }
+        }
+        if (!best.isEmpty()) return best;
+        // Legal global card dictionary is not opponent deck knowledge. Prefer the prior native fallback if legal.
+        ICardFace fallback = StaticData.instance().getCommonCards().getFaceByName("Morphling");
+        if (fallback != null && allowed.test(fallback)) return fallback.getName();
+        // A lazy cache can depend on which hidden deck cards were loaded. Use the COMPLETE public dictionary.
+        StaticData.instance().ensureAllCardsLoaded();
+        return StaticData.instance().getCommonCards().streamAllFaces()
+                .filter(allowed)
+                .map(ICardFace::getName).sorted().findFirst().orElse("");
+    }
+}
