+package forge.ai;
+
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.keyword.Keyword;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+
+/** Narrow public-observation survival floor, independent of a profile's normal response probability. */
+public final class ObservedLethalCounterGuard {
+    private ObservedLethalCounterGuard() { }
+
+    public static boolean shouldCounter(Player ai, SpellAbility incoming) {
+        if (incoming == null || incoming.getActivatingPlayer() == null
+                || !incoming.getActivatingPlayer().isOpponentOf(ai) || ai.getLife() <= 0) return false;
+        Card card = incoming.getHostCard();
+        if (card == null || !card.getView().canBeShownTo(ai.getView())
+                || !card.getView().canFaceDownBeShownTo(ai.getView())) return false;
+
+        // Only literal public damage, not an arbitrary SVar calculation that could inspect private cards.
+        if (incoming.getApi() == ApiType.DealDamage && incoming.getTargets().contains(ai)) {
+            String amount = incoming.getParamOrDefault("NumDmg", "");
+            if (amount.matches("[0-9]+")) {
+                try { if (Long.parseLong(amount) >= ai.getLife()) return true; }
+                catch (NumberFormatException ignored) { /* no claim for an unrepresentable amount */ }
+            }
+        }
+
+        // Public, immediately lethal haste into an empty defending board. No copied game or hidden information.
+        return incoming.isSpell() && card.isCreature() && card.hasKeyword(Keyword.HASTE)
+                && ai.getGame().getPhaseHandler().is(PhaseType.MAIN1)
+                && ai.getGame().getPhaseHandler().getPlayerTurn() == incoming.getActivatingPlayer()
+                && ai.getCreaturesInPlay().isEmpty() && card.getNetPower() >= ai.getLife();
+    }
+}
