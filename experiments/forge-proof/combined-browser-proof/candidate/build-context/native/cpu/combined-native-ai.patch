+package forge.ai;
+
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.player.Player;
+
+/** Current lawful observations, not a hidden deck manifest or remembered private-zone membership. */
+public final class VisibleAiCards {
+    private VisibleAiCards() { }
+
+    public static boolean canKnow(final Player viewer, final Card card) {
+        return card.getView().canBeShownTo(viewer.getView())
+                && card.getView().canFaceDownBeShownTo(viewer.getView());
+    }
+
+    public static CardCollection knownTo(final Player viewer, final Iterable<Card> cards) {
+        final CardCollection known = new CardCollection();
+        for (final Card card : cards) {
+            if (canKnow(viewer, card)) known.add(card);
+        }
+        return known;
+    }
+}
