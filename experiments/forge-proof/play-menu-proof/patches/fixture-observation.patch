+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import http from 'node:http';
+import { FixtureObservationCache } from './observation.mjs';
+const TOKEN = 'synthetic-observer-test';
+const GEN = '00000000-0000-4000-8000-000000000001';
+const id = n => '00000000-0000-4000-8000-' + String(n).padStart(12, '0');
+const authorization = { Authorization: 'Bearer ' + TOKEN };
+const base = 'http://127.0.0.1';
+const body = (matchId = id(2), generation = GEN, status = 'running') => ({ matchId, generation, status,
+  ...(status === 'finished' ? { result: { draw: false, winnerPlayerId: 1 } } : { snapshot: { revision: 3, viewer: 0, players: [{ isViewer: false, zones: { Hand: { count: 7, cards: [] }, Library: { count: 92, cards: [] } } }] } }) });
+const read = (cache, matchId = id(2), options = {}) => cache.observe({ method: 'GET', url: base + '/__fixture/observe/' + matchId, headers: authorization, ...options });
+function delivery(cache, value, { method = 'GET', status = 200, matchId = value.matchId || id(2), headers = authorization, suffix = '' } = {}) {
+  const response = new EventEmitter();
+  const capture = cache.capture({ method, url: base + '/api/play/matches/' + matchId + suffix, headers, httpStatus: status, response });
+  const bytes = Buffer.from(JSON.stringify(value));
+  capture.chunk(bytes.subarray(0, 17)); capture.chunk(bytes.subarray(17)); capture.complete();
+  return { response, capture, bytes };
+}
+test('cache contains only exact complete JSON after response finish, never beforehand', () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN }), value = body();
+  const { response } = delivery(cache, value);
+  assert.equal(read(cache).status, 202);
+  response.emit('finish');
+  const result = read(cache); assert.equal(result.status, 200); assert.deepEqual(result.body.body, value);
+  assert.equal(result.body.httpStatus, 200); assert.equal(result.body.sequence, 1);
+  assert.deepEqual(result.body.body.snapshot.players[0].zones.Hand.cards, []);
+  result.body.body.snapshot.viewer = 999; assert.equal(read(cache).body.body.snapshot.viewer, 0);
+});
+test('unfinished/aborted/error stream cannot become evidence', () => {
+  for (const failure of ['close', 'error']) {
+    const cache = new FixtureObservationCache({ bearer: TOKEN }), value = body();
+    const { response } = delivery(cache, value); response.emit(failure, Error('fixture transport failure')); response.emit('finish');
+    assert.equal(read(cache).status, 202);
+  }
+  const cache = new FixtureObservationCache({ bearer: TOKEN }), response = new EventEmitter();
+  const capture = cache.capture({ method: 'GET', url: base + '/api/play/matches/' + id(2), headers: authorization, httpStatus: 200, response });
+  capture.chunk(Buffer.from('{"incomplete":')); response.emit('finish'); capture.complete(); assert.equal(read(cache).status, 202);
+});
+test('observer requires synthetic auth and rejects mutation, generation and seat selectors', () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN }); delivery(cache, body()).response.emit('finish');
+  for (const headers of [{}, { Authorization: 'Bearer wrong' }]) assert.equal(read(cache, id(2), { headers }).status, 401);
+  for (const method of ['POST', 'DELETE', 'PUT', 'HEAD']) assert.equal(read(cache, id(2), { method }).status, 405);
+  assert.equal(read(cache, id(2), { headers: { ...authorization, 'X-Fixture-Generation': id(99) } }).status, 404);
+  assert.equal(read(cache, id(2), { headers: { ...authorization, 'X-Fixture-Generation': GEN } }).status, 200);
+  assert.equal(read(cache, id(3), { headers: { ...authorization, 'X-Fixture-Generation': GEN } }).status, 404);
+  for (const field of ['seat', 'viewer', 'player', 'anything']) assert.equal(read(cache, id(2), { url: base + '/__fixture/observe/' + id(2) + '?' + field + '=1' }).status, 400);
+  for (const header of ['X-Seat', 'X-Fixture-Viewer', 'X-Player-Id']) assert.equal(read(cache, id(2), { headers: { ...authorization, [header]: '1' } }).status, 400);
+});
+test('POST/action/DELETE/private routes and wrong account cannot seed observations', () => {
+  for (const options of [{ method: 'POST' }, { method: 'DELETE' }, { suffix: '/actions' }, { suffix: '?viewer=1' }, { headers: {} }]) {
+    const cache = new FixtureObservationCache({ bearer: TOKEN }); delivery(cache, body(), options).response.emit('finish'); assert.equal(read(cache).status, 202);
+  }
+  const cache = new FixtureObservationCache({ bearer: TOKEN }), wrong = body(id(3));
+  delivery(cache, wrong, { matchId: id(2) }).response.emit('finish'); assert.equal(read(cache).status, 202);
+});
+test('four bounded records, no observation-induced eviction renewal, strictly increasing deliveries', () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN });
+  for (let n = 2; n <= 5; n++) delivery(cache, body(id(n))).response.emit('finish');
+  assert.equal(read(cache, id(2)).body.sequence, 1);
+  for (let i = 0; i < 20; i++) read(cache, id(2));
+  delivery(cache, body(id(6))).response.emit('finish');
+  assert.equal(read(cache, id(2)).status, 202); assert.equal(read(cache, id(6)).body.sequence, 5);
+  const bounded = new FixtureObservationCache({ bearer: TOKEN, maximumBytes: 64 });
+  delivery(bounded, body()).response.emit('finish'); assert.equal(read(bounded).status, 202);
+  assert.throws(() => new FixtureObservationCache({ bearer: TOKEN, maximumRecords: 5 }));
+  assert.throws(() => new FixtureObservationCache({ bearer: TOKEN, maximumBytes: 4194305 }));
+});
+test('generation replacement fences previous observer binding and keeps exact delivered errors', () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN }); delivery(cache, body()).response.emit('finish');
+  delivery(cache, { error: 'native_state_temporarily_unavailable' }, { status: 503 }).response.emit('finish');
+  assert.equal(read(cache).body.httpStatus, 503); assert.deepEqual(read(cache).body.body, { error: 'native_state_temporarily_unavailable' });
+  delivery(cache, body(id(2), id(9))).response.emit('finish');
+  assert.equal(read(cache, id(2), { headers: { ...authorization, 'X-Fixture-Generation': GEN } }).status, 404);
+  assert.equal(read(cache).body.generation, id(9));
+});
+test('terminal copy survives UI DELETE and late nonterminal/error delivery', () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN }); const terminal = body(id(2), GEN, 'finished');
+  delivery(cache, terminal).response.emit('finish'); const sequence = read(cache).body.sequence;
+  delivery(cache, {}, { method: 'DELETE', status: 204 }).response.emit('finish');
+  delivery(cache, body(id(2), GEN, 'initializing'), { status: 202 }).response.emit('finish');
+  delivery(cache, { error: 'match_closed' }, { status: 410 }).response.emit('finish');
+  assert.deepEqual(read(cache).body.body, terminal); assert.equal(read(cache).body.sequence, sequence);
+});
+test('actual HTTP observer polling performs no service/provider/storage work or idle renewal', async () => {
+  const cache = new FixtureObservationCache({ bearer: TOKEN });
+  const counters = { serviceReads: 0, actions: 0, storageReads: 0, storageWrites: 0, idleRenewals: 0 };
+  const allocation = { lastAuthorizedAt: 123456, generation: GEN };
+  let origin;
+  const server = http.createServer((request, response) => {
+    const url = new URL(request.url, origin);
+    if (url.pathname.startsWith('/__fixture/observe')) {
+      const result = cache.observe({ method: request.method, url, headers: request.headers });
+      response.writeHead(result.status, result.headers).end(JSON.stringify(result.body)); return;
+    }
+    counters.serviceReads++; counters.storageReads++; counters.storageWrites++; counters.idleRenewals++; allocation.lastAuthorizedAt++;
+    const bytes = Buffer.from(JSON.stringify(body()));
+    const delivered = cache.capture({ method: request.method, url, headers: request.headers, httpStatus: 200, response });
+    response.writeHead(200, { 'Content-Type': 'application/json' }); response.write(bytes); delivered.chunk(bytes); delivered.complete(); response.end();
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve)); origin = 'http://127.0.0.1:' + server.address().port;
+  try {
+    const publicResponse = await fetch(origin + '/api/play/matches/' + id(2), { headers: authorization }); const delivered = await publicResponse.json();
+    const before = structuredClone({ counters, allocation });
+    for (let i = 0; i < 12; i++) {
+      const response = await fetch(origin + '/__fixture/observe/' + id(2), { headers: { ...authorization, 'X-Fixture-Generation': GEN } });
+      assert.equal(response.status, 200); assert.deepEqual((await response.json()).body, delivered);
+    }
+    const denied = await fetch(origin + '/__fixture/observe/' + id(2), { method: 'POST', headers: authorization, body: '{"op":"concede"}' }); assert.equal(denied.status, 405);
+    assert.deepEqual({ counters, allocation }, before);
+  } finally { server.closeAllConnections(); await new Promise(resolve => server.close(resolve)); }
+});
