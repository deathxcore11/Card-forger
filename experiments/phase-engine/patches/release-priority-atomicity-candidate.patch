+/// Versioned read-only Priority proof. Null, unknown versions, and all statuses
+/// except actionless must stop automatic passing. Even actionless requires
+/// passVerified=true and floatingMana=false, plus caller-owned decision guards.
+#[wasm_bindgen]
+pub fn get_priority_capability_v1_js(player_id: u32) -> JsValue {
+    let viewer = match viewer_player_id(player_id) {
+        Ok(viewer) => viewer,
+        Err(_) => return JsValue::NULL,
+    };
+    match with_state(|state| {
+        to_js(&engine::game::engine::priority_capability_for_viewer_v1(state, viewer))
+    }) {
+        Ok(value) => value,
         Err(_) => JsValue::NULL,
     }
 }
