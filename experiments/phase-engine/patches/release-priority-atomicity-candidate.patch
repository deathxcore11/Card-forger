+/// Versioned, viewer-scoped proof for voluntary empty-window automation.
+/// This contains no actions, object identities, or private diagnostic payloads.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PriorityCapabilityV1 {
+    pub version: u8,
+    pub status: PriorityCapabilityStatusV1,
+    pub actor: Option<PlayerId>,
+    pub priority_holder: Option<PlayerId>,
+    pub floating_mana: Option<bool>,
+    pub pass_verified: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum PriorityCapabilityStatusV1 {
+    Actionless,
+    Actionable,
+    NotPriority,
+    Unknown,
+}
+
+/// Read-only certification from the reducer-family preflight, never the AI
+/// action list or either legacy auto-pass recommendation. V1 is deliberately
+/// limited to two-seat, non-shared-turn games. The caller must still bind this
+/// observation to its current decision/revision, preserve floating mana and
+/// user stops, and recompute it inside the serialized submission boundary.
+pub fn priority_capability_for_viewer_v1(
+    state: &GameState,
+    viewer: PlayerId,
+) -> PriorityCapabilityV1 {
+    let mut result = PriorityCapabilityV1 {
+        version: 1,
+        status: PriorityCapabilityStatusV1::Unknown,
+        actor: None,
+        priority_holder: None,
+        floating_mana: None,
+        pass_verified: false,
+    };
+    if state.players.len() != 2
+        || state.format_config.topology().has_shared_team_turns()
+        || viewer.0 as usize >= state.players.len()
+        || state.active_player.0 as usize >= state.players.len()
+    {
+        return result;
+    }
+    let holder = match &state.waiting_for {
+        WaitingFor::Priority { player } => *player,
+        _ => {
+            result.status = PriorityCapabilityStatusV1::NotPriority;
+            return result;
+        }
+    };
+    if holder.0 as usize >= state.players.len()
+        || state.priority_player.0 as usize >= state.players.len()
+        || state.turn_decision_controller.is_some_and(|id| id.0 as usize >= state.players.len())
+    {
+        return result;
+    }
+    let Ok(principal) = priority_principal_for_preflight(state) else {
+        return result;
+    };
+    if principal.authenticated_actor() != viewer {
+        return result;
+    }
+    // Derived layers and reducer previews touch only this disposable state.
+    let mut projected = state.clone();
+    super::layers::flush_layers(&mut projected);
+    result.actor = Some(viewer);
+    result.priority_holder = Some(holder);
+    result.floating_mana = Some(projected.players[holder.0 as usize].mana_pool.total() > 0);
+    match preflight_priority_window(&projected) {
+        PriorityPreflight::Actionless => {
+            // A proof of no alternatives is distinct from permission to pass.
+            // Verify the exact pass through the canonical reducer as well.
+            if apply_interaction_for_simulation(
+                &mut projected,
+                viewer,
+                holder,
+                GameAction::PassPriority,
+            )
+            .is_ok()
+            {
+                result.status = PriorityCapabilityStatusV1::Actionless;
+                result.pass_verified = true;
+            }
+        }
+        PriorityPreflight::Actionable { .. } => {
+            result.status = PriorityCapabilityStatusV1::Actionable;
+        }
+        PriorityPreflight::NotPriorityWindow | PriorityPreflight::Indeterminate { .. } => {}
+    }
+    result
 }
 
