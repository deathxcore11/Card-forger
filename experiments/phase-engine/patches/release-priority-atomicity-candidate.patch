+// Candidate source only: requires compile and real-WASM acceptance before shipping.
+use engine::game::engine::{priority_capability_for_viewer_v1, PriorityCapabilityStatusV1};
+use engine::game::zones;
+use engine::types::{GameState, PlayerId};
+use engine::types::game_state::WaitingFor;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+use engine::types::identifiers::{ObjectId, CardId};
+
+fn empty_priority() -> GameState {
+    let mut state = GameState::new_two_player(42);
+    state.active_player = PlayerId(0);
+    state.priority_player = PlayerId(0);
+    state.phase = Phase::PreCombatMain;
+    state.waiting_for = WaitingFor::Priority { player: PlayerId(0) };
+    state
+}
+
+#[test]
+fn empty_window_is_certified_without_live_mutation() {
+    let state = empty_priority();
+    let before = state.clone();
+    let capability = priority_capability_for_viewer_v1(&state, PlayerId(0));
+    assert_eq!(capability.version, 1);
+    assert_eq!(capability.status, PriorityCapabilityStatusV1::Actionless);
+    assert_eq!(capability.actor, Some(PlayerId(0)));
+    assert_eq!(capability.priority_holder, Some(PlayerId(0)));
+    assert_eq!(capability.floating_mana, Some(false));
+    assert!(capability.pass_verified);
+    assert_eq!(state, before);
+}
+
+#[test]
+fn unauthorized_or_invalid_viewer_gets_no_private_facts() {
+    let state = empty_priority();
+    for viewer in [PlayerId(1), PlayerId(2), PlayerId(255)] {
+        let capability = priority_capability_for_viewer_v1(&state, viewer);
+        assert_eq!(capability.status, PriorityCapabilityStatusV1::Unknown);
+        assert_eq!(capability.actor, None);
+        assert_eq!(capability.priority_holder, None);
+        assert_eq!(capability.floating_mana, None);
+        assert!(!capability.pass_verified);
+    }
+}
+
+#[test]
+fn controller_authority_and_semantic_holder_remain_distinct() {
+    let mut state = empty_priority();
+    state.turn_decision_controller = Some(PlayerId(1));
+    state.priority_player = PlayerId(1);
+    let capability = priority_capability_for_viewer_v1(&state, PlayerId(1));
+    assert_eq!(capability.actor, Some(PlayerId(1)));
+    assert_eq!(capability.priority_holder, Some(PlayerId(0)));
+    assert_eq!(priority_capability_for_viewer_v1(&state, PlayerId(0)).actor, None);
+    state.priority_player = PlayerId(0);
+    assert_eq!(priority_capability_for_viewer_v1(&state, PlayerId(1)).status, PriorityCapabilityStatusV1::Unknown);
+}
+
+#[test]
+fn floating_mana_is_a_separate_required_stop() {
+    use engine::types::mana::{ManaType, ManaUnit};
+    let mut state = empty_priority();
+    state.players[0].mana_pool.add(ManaUnit::new(ManaType::Colorless, ObjectId(0), false, vec![]));
+    let before = state.clone();
+    let capability = priority_capability_for_viewer_v1(&state, PlayerId(0));
+    assert_eq!(capability.floating_mana, Some(true));
+    assert_eq!(state, before);
+}
+
+#[test]
+fn legal_land_play_prevents_an_actionless_certificate() {
+    let mut state = empty_priority();
+    let land = zones::create_object(&mut state, CardId(1), PlayerId(0), "Island".to_owned(), Zone::Hand);
+    state.objects.get_mut(&land).unwrap().card_types.core_types.push(engine::types::card_type::CoreType::Land);
+    let before = state.clone();
+    let capability = priority_capability_for_viewer_v1(&state, PlayerId(0));
+    assert_eq!(capability.status, PriorityCapabilityStatusV1::Actionable);
+    assert!(!capability.pass_verified);
+    assert_eq!(state, before);
+}
+
+#[test]
+fn terminal_is_never_a_priority_certificate() {
+    let mut state = empty_priority();
+    state.waiting_for = WaitingFor::GameOver { winner: None };
+    let capability = priority_capability_for_viewer_v1(&state, PlayerId(0));
+    assert_eq!(capability.status, PriorityCapabilityStatusV1::NotPriority);
+    assert!(!capability.pass_verified);
+}
+
+#[test]
+fn wire_contract_is_versioned_and_contains_no_action_payloads() {
+    let capability = priority_capability_for_viewer_v1(&empty_priority(), PlayerId(1));
+    let wire = serde_json::to_value(capability).unwrap();
+    assert_eq!(wire, serde_json::json!({
+        "version": 1,
+        "status": "unknown",
+        "actor": null,
+        "priorityHolder": null,
+        "floatingMana": null,
+        "passVerified": false
+    }));
+}
