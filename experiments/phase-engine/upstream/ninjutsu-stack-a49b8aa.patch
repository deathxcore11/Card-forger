+#[test]
+fn copied_ninjutsu_does_not_extend_original_announcement_reveal() {
+    let mut fixture = setup(NinjutsuVariant::Ninjutsu, false);
+    let original = announce(&mut fixture);
+    fixture
+        .runner
+        .act(GameAction::PassPriority)
+        .expect("give opponent priority");
+    drop(
+        fixture
+            .runner
+            .cast(fixture.favor)
+            .modes(&[0])
+            .target_object(original)
+            .commit(),
+    );
+    fixture.runner.pass_both_players();
+    assert_eq!(fixture.runner.state().stack.len(), 2);
+    fixture
+        .runner
+        .act(GameAction::PassPriority)
+        .expect("give opponent another response");
+    drop(
+        fixture
+            .runner
+            .cast(fixture.stifle)
+            .target_object(original)
+            .commit(),
+    );
+    fixture.runner.pass_both_players();
+    assert_eq!(
+        fixture.runner.state().stack.len(),
+        1,
+        "only the copied ability survives Stifle"
+    );
+    assert_ne!(fixture.runner.state().stack.back().unwrap().id, original);
+    assert!(
+        !fixture
+            .runner
+            .state()
+            .holds_stack_bound_reveal(fixture.ninja),
+        "countering the activated ability ends its reveal; its copy was not activated"
+    );
+    fixture.runner.pass_both_players();
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.ninja].zone,
+        Zone::Hand
+    );
+    assert!(!fixture
+        .runner
+        .state()
+        .holds_stack_bound_reveal(fixture.ninja));
+    assert!(
+        !fixture
+            .runner
+            .state()
+            .public_revealed_cards
+            .contains(&fixture.ninja),
+        "stack reveal never becomes an until-zone-change reveal"
+    );
+}
