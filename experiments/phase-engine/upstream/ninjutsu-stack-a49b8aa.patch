+#[test]
+fn copied_ninjutsu_uses_copy_controller_and_keeps_original_source() {
+    for variant in [
+        NinjutsuVariant::Ninjutsu,
+        NinjutsuVariant::CommanderNinjutsu,
+    ] {
+        let mut fixture = setup(variant, false);
+        let original = announce(&mut fixture);
+        fixture
+            .runner
+            .act(GameAction::PassPriority)
+            .expect("give copying opponent priority");
+        drop(
+            fixture
+                .runner
+                .cast(fixture.favor)
+                .modes(&[0])
+                .target_object(original)
+                .commit(),
+        );
+        fixture.runner.pass_both_players();
+        assert_eq!(
+            fixture.runner.state().stack.len(),
+            2,
+            "copy plus original remain"
+        );
+        let copy = fixture.runner.state().stack.back().unwrap();
+        assert_eq!(copy.controller, P1);
+        assert_eq!(
+            copy.source_id, fixture.ninja,
+            "ability copy keeps the original source"
+        );
+        assert_ne!(copy.id, original);
+        fixture.runner.pass_both_players();
+        match variant {
+            NinjutsuVariant::Ninjutsu => {
+                assert_eq!(
+                    fixture.runner.state().objects[&fixture.ninja].zone,
+                    Zone::Hand,
+                    "copy controller cannot take a card from another player's hand"
+                );
+                assert!(
+                    fixture
+                        .runner
+                        .state()
+                        .holds_stack_bound_reveal(fixture.ninja),
+                    "original ability still holds its reveal lease"
+                );
+                fixture.runner.pass_both_players();
+                assert_eq!(
+                    fixture.runner.state().objects[&fixture.ninja].controller,
+                    P0
+                );
+                assert_eq!(
+                    fixture.runner.state().objects[&fixture.ninja].zone,
+                    Zone::Battlefield
+                );
+            }
+            NinjutsuVariant::CommanderNinjutsu => {
+                let ninja = &fixture.runner.state().objects[&fixture.ninja];
+                assert_eq!(ninja.zone, Zone::Battlefield);
+                assert_eq!(
+                    ninja.controller, P1,
+                    "commander ninjutsu copy puts the source under the copy controller"
+                );
+                assert!(ninja.tapped);
+                assert!(
+                    !fixture
+                        .runner
+                        .state()
+                        .combat
+                        .as_ref()
+                        .unwrap()
+                        .attackers
+                        .iter()
+                        .any(|a| a.object_id == fixture.ninja),
+                    "a nonattacking player's creature cannot enter attacking"
+                );
+                fixture.runner.pass_both_players();
+                assert_eq!(
+                    fixture.runner.state().objects[&fixture.ninja].controller,
+                    P1,
+                    "original cannot move the departed source occurrence again"
+                );
+            }
+        }
+    }
+}
