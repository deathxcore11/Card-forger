+#[test]
+fn rings_observes_ninjutsu_and_copies_its_countered_activation() {
+    let mut fixture = setup_with_rings(NinjutsuVariant::Ninjutsu, false, true);
+    for _ in 0..2 {
+        let _ = fixture.runner.state_mut().add_mana_to_pool(
+            P0,
+            ManaUnit::new(ManaType::Colorless, fixture.attacker, false, vec![]),
+        );
+    }
+    fixture
+        .runner
+        .act(GameAction::ActivateNinjutsu {
+            ninjutsu_object_id: fixture.ninja,
+            creature_to_return: fixture.attacker,
+        })
+        .expect("pay and announce ninjutsu while Rings can copy it");
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.ninja].zone,
+        Zone::Hand
+    );
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.attacker].zone,
+        Zone::Hand
+    );
+    assert_eq!(
+        fixture.runner.state().stack.len(),
+        2,
+        "Rings trigger is above the unresolved ninjutsu ability"
+    );
+    assert_eq!(
+        fixture.runner.state().stack.back().unwrap().source_id,
+        fixture.rings.unwrap()
+    );
+    assert!(matches!(
+        fixture.runner.state().stack.back().unwrap().kind,
+        StackEntryKind::TriggeredAbility { .. }
+    ));
+    let original = fixture.runner.state().stack.front().unwrap().id;
+    fixture
+        .runner
+        .act(GameAction::PassPriority)
+        .expect("opponent may respond before Rings resolves");
+    drop(
+        fixture
+            .runner
+            .cast(fixture.stifle)
+            .target_object(original)
+            .commit(),
+    );
+    fixture.runner.pass_both_players();
+    assert_eq!(fixture.runner.state().stack.len(), 1);
+    assert!(
+        fixture
+            .runner
+            .state()
+            .departed_activated_abilities
+            .contains_key(&original),
+        "the exact countered activation remains available to its trigger"
+    );
+    fixture.runner.pass_both_players();
+    assert!(matches!(
+        fixture.runner.state().waiting_for,
+        WaitingFor::OptionalEffectChoice { .. }
+    ));
+    let copied = fixture
+        .runner
+        .act(GameAction::DecideOptionalEffect { accept: true })
+        .expect("pay Rings' optional two mana");
+    assert!(
+        !copied
+            .events
+            .iter()
+            .any(|event| matches!(event, GameEvent::AbilityActivated { .. })),
+        "copying an activated ability does not activate it again"
+    );
+    if matches!(
+        fixture.runner.state().waiting_for,
+        WaitingFor::CopyRetarget { .. }
+    ) {
+        fixture
+            .runner
+            .act(GameAction::KeepAllCopyTargets)
+            .expect("ninjutsu has no targets to change");
+    }
+    assert_eq!(
+        fixture.runner.state().stack.len(),
+        1,
+        "Rings copies the departed ability, without substituting another stack object"
+    );
+    let copy = fixture.runner.state().stack.back().unwrap();
+    assert_eq!(copy.source_id, fixture.ninja);
+    assert_ne!(copy.id, original);
+    assert!(matches!(
+        copy.kind,
+        StackEntryKind::KeywordAction {
+            action: KeywordAction::Ninjutsu { .. }
+        }
+    ));
+    fixture.runner.pass_both_players();
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.ninja].zone,
+        Zone::Battlefield
+    );
+    assert!(fixture.runner.state().objects[&fixture.ninja].tapped);
+}
