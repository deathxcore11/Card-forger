+/// CR 702.49a-d + CR 400.7: resolve the paid ability against its original
+/// card occurrence. Costs are never paid again, even when entry does nothing.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn resolve_ninjutsu(
+    state: &mut GameState,
+    player: PlayerId,
+    source: ObjectIdentityBinding,
+    variant: NinjutsuVariant,
+    defending_player: PlayerId,
+    attack_target: AttackTarget,
+    attack_target_identity: Option<ObjectIncarnationRef>,
+    events: &mut Vec<GameEvent>,
+) {
+    let ninjutsu_obj_id = source.reference.object_id;
+    if !source.reference.is_current(state)
+        || !state
+            .objects
+            .get(&ninjutsu_obj_id)
+            .is_some_and(|object| object.zone == source.expected_zone)
+    {
+        return;
+    }
+    // CR 109.5 + CR 702.49a/d + CR 707.10b: ordinary ninjutsu says "from
+    // your hand"; commander ninjutsu's effect has no such controller-bound
+    // zone restriction. A copied ability retains its source and uses its own
+    // controller for "your" and for entry control.
+    if matches!(variant, NinjutsuVariant::Ninjutsu)
+        && !state.players[player.0 as usize]
+            .hand
+            .contains(&ninjutsu_obj_id)
+    {
+        return;
