+#[cfg(test)]
+mod ninjutsu_definition_tests {
+    use super::{activated_ability_definitions, activation_ability_definition};
+    use crate::game::layers::{flush_layers, mark_layers_full};
+    use crate::game::scenario::{GameScenario, P0};
+    use crate::game::scenario_db::GameScenarioDbExt;
+    use crate::game::zones::move_to_zone;
+    use crate::types::ability::{AbilityCost, NinjutsuVariant};
+    use crate::types::mana::{ManaCost, ManaCostShard};
+    use crate::types::zones::Zone;
+
+    #[test]
+    fn granted_ninjutsu_indices_match_lookup_without_duplicating_printed_markers() {
+        let db = crate::test_support::shared_card_db();
+        let mut scenario = GameScenario::new();
+        let satoru = scenario.add_real_card(P0, "Satoru Umezawa", Zone::Battlefield, db);
+        let cards = [
+            "Grizzly Bears",
+            "Ninja of the Deep Hours",
+            "Yuriko, the Tiger's Shadow",
+        ]
+        .map(|name| scenario.add_real_card(P0, name, Zone::Hand, db));
+        let mut runner = scenario.build();
+        mark_layers_full(runner.state_mut());
+        flush_layers(runner.state_mut());
+        let granted_cost = AbilityCost::NinjutsuFamily {
+            variant: NinjutsuVariant::Ninjutsu,
+            mana_cost: ManaCost::Cost {
+                shards: vec![ManaCostShard::Blue, ManaCostShard::Black],
+                generic: 2,
+            },
+        };
+        for card in cards {
+            let printed = &runner.state().objects[&card].abilities;
+            let definitions = activated_ability_definitions(runner.state(), card);
+            assert_eq!(definitions.len(), printed.len() + 1);
+            for (index, definition) in &definitions {
+                assert_eq!(
+                    activation_ability_definition(runner.state(), card, *index).as_ref(),
+                    Some(definition),
+                    "enumeration and indexed lookup must bind the same variant and cost"
+                );
+                if *index < printed.len() {
+                    assert_eq!(definition, &printed[*index]);
+                }
+            }
+            assert_eq!(definitions.last().unwrap().0, printed.len());
+            assert_eq!(
+                definitions.last().unwrap().1.cost.as_ref(),
+                Some(&granted_cost)
+            );
+        }
+
+        move_to_zone(runner.state_mut(), satoru, Zone::Hand, &mut vec![]);
+        mark_layers_full(runner.state_mut());
+        flush_layers(runner.state_mut());
+        for card in cards {
+            let definitions = activated_ability_definitions(runner.state(), card);
+            let printed = &runner.state().objects[&card].abilities;
+            assert_eq!(definitions.len(), printed.len(), "the grant has expired");
+            for (index, definition) in definitions {
+                assert_eq!(definition, printed[index]);
+                assert_eq!(
+                    activation_ability_definition(runner.state(), card, index),
+                    Some(definition)
+                );
+            }
+        }
+    }
+}
