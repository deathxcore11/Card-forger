+#[test]
+fn satoru_granted_ninjutsu_survives_returning_its_grant_source_as_cost() {
+    let db = crate::support::shared_card_db().expect("tracked production card fixture");
+    // The production fixture carries Satoru's complete, verbatim MTGJSON text,
+    // including "Each creature card in your hand has ninjutsu {2}{U}{B}."
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::DeclareBlockers);
+    let satoru = scenario.add_real_card(P0, "Satoru Umezawa", Zone::Battlefield, db);
+    let bears = scenario.add_real_card(P0, "Grizzly Bears", Zone::Hand, db);
+    let response = scenario.add_real_card(P1, "Lightning Bolt", Zone::Hand, db);
+    let mut runner = scenario.build();
+    let granted_mana = ManaCost::Cost {
+        shards: vec![ManaCostShard::Blue, ManaCostShard::Black],
+        generic: 2,
+    };
+    let granted_cost = AbilityCost::NinjutsuFamily {
+        variant: NinjutsuVariant::Ninjutsu,
+        mana_cost: granted_mana.clone(),
+    };
+    let state = runner.state_mut();
+    state.combat = Some(CombatState {
+        attackers: vec![AttackerInfo::attacking_player(satoru, P1)],
+        ..Default::default()
+    });
+    state.waiting_for = WaitingFor::Priority { player: P0 };
+    state.priority_player = P0;
+    for player in [P0, P1] {
+        state
+            .priority_passing_modes
+            .insert(player, PriorityPassingMode::FullControl);
+    }
+    for color in [
+        ManaType::Blue,
+        ManaType::Black,
+        ManaType::Colorless,
+        ManaType::Colorless,
+    ] {
+        let _ = state.add_mana_to_pool(P0, ManaUnit::new(color, satoru, false, vec![]));
+    }
+    let _ = state.add_mana_to_pool(P1, ManaUnit::new(ManaType::Red, response, false, vec![]));
+    engine::game::layers::mark_layers_full(state);
+    engine::game::layers::flush_layers(state);
+    assert!(
+        state.objects[&bears].base_keywords.is_empty(),
+        "Bears has no printed ninjutsu"
+    );
+    assert!(state.objects[&bears]
+        .keywords
+        .contains(&Keyword::Ninjutsu(granted_mana)));
+    let definitions = engine::game::casting::activated_ability_definitions(state, bears);
+    assert_eq!(
+        definitions.len(),
+        1,
+        "Satoru's grant has an activation definition"
+    );
+    let (ability_index, definition) = &definitions[0];
+    assert_eq!(definition.cost.as_ref(), Some(&granted_cost));
+    assert!(
+        engine::ai_support::legal_actions(state)
+            .iter()
+            .any(|action| matches!(action,
+                GameAction::ActivateNinjutsu { ninjutsu_object_id, creature_to_return }
+                    if *ninjutsu_object_id == bears && *creature_to_return == satoru
+            )),
+        "the real granted activation must be offered"
+    );
+
+    let result = runner
+        .act(GameAction::ActivateNinjutsu {
+            ninjutsu_object_id: bears,
+            creature_to_return: satoru,
+        })
+        .expect("pay for the granted ninjutsu ability, returning Satoru");
+    let state = runner.state();
+    assert_eq!(state.objects[&satoru].zone, Zone::Hand);
+    assert_eq!(state.objects[&bears].zone, Zone::Hand);
+    assert_eq!(state.players[0].mana_pool.total(), 0);
+    assert!(
+        state.objects[&bears].keywords.is_empty(),
+        "returning Satoru removes the grant"
+    );
+    assert!(engine::game::casting::activated_ability_definitions(state, bears).is_empty());
+    assert!(state.pending_activations.contains(&(bears, *ability_index)));
+    assert_eq!(
+        state.stack.len(),
+        1,
+        "the paid ability survives its lost grant"
+    );
+    let ability = state.stack.back().unwrap().id;
+    assert!(matches!(&state.stack.back().unwrap().kind,
+        StackEntryKind::KeywordAction { action: KeywordAction::Ninjutsu { source, variant: NinjutsuVariant::Ninjutsu, .. } }
+            if source.reference.object_id == bears && source.expected_zone == Zone::Hand
+    ));
+    assert_eq!(result.events.iter().filter(|event| matches!(event,
+        GameEvent::AbilityActivated { player_id: P0, source_id, kind: ActivatedAbilityKind::Normal,
+            stack_entry: Some(entry), activation_cost: BoundActivationCost::Cost(cost), .. }
+            if *source_id == bears && *entry == ability && cost.as_ref() == &granted_cost
+    )).count(), 1, "the generic activation event retains the original granted cost");
+    assert_eq!(
+        result
+            .events
+            .iter()
+            .filter(|event| matches!(event,
+                GameEvent::NinjutsuActivated { source_id, .. } if *source_id == bears
+            ))
+            .count(),
+        1
+    );
+    assert!(state.holds_stack_bound_reveal(bears));
+
+    runner
+        .act(GameAction::PassPriority)
+        .expect("allow an opponent response");
+    assert_eq!(
+        runner.state().waiting_for,
+        WaitingFor::Priority { player: P1 }
+    );
+    drop(runner.cast(response).target_player(P0).commit());
+    assert_eq!(
+        runner.state().stack.len(),
+        2,
+        "the response is above ninjutsu"
+    );
+    runner.pass_both_players();
+    assert_eq!(runner.state().players[0].life, 17);
+    assert_eq!(runner.state().stack.back().unwrap().id, ability);
+    runner.pass_both_players();
+    let state = runner.state();
+    assert_eq!(state.objects[&bears].zone, Zone::Battlefield);
+    assert!(state.objects[&bears].tapped);
+    let attacker = state
+        .combat
+        .as_ref()
+        .unwrap()
+        .attackers
+        .iter()
+        .find(|attacker| attacker.object_id == bears)
+        .expect("Bears enters attacking");
+    assert_eq!(attacker.attack_target, AttackTarget::Player(P1));
+    assert_eq!(attacker.defending_player, P1);
+    assert!(!state.holds_stack_bound_reveal(bears));
+    assert!(state.stack.is_empty());
+    assert!(state.resolving_stack_entry.is_none());
+    assert!(matches!(state.waiting_for, WaitingFor::Priority { .. }));
+}
