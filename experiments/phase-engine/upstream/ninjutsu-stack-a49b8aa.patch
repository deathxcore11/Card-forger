+#[test]
+fn ninjutsu_does_not_follow_a_source_that_left_and_returned_to_hand() {
+    let mut fixture = setup(NinjutsuVariant::Ninjutsu, false);
+    announce(&mut fixture);
+    let original =
+        ObjectIncarnationRef::from_object(&fixture.runner.state().objects[&fixture.ninja]);
+    move_to_zone(
+        fixture.runner.state_mut(),
+        fixture.ninja,
+        Zone::Exile,
+        &mut vec![],
+    );
+    move_to_zone(
+        fixture.runner.state_mut(),
+        fixture.ninja,
+        Zone::Hand,
+        &mut vec![],
+    );
+    assert!(
+        !original.is_current(fixture.runner.state()),
+        "reach guard: same storage id, new object"
+    );
+    fixture.runner.pass_both_players();
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.ninja].zone,
+        Zone::Hand
+    );
+    assert!(fixture.runner.state().stack.is_empty());
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.attacker].zone,
+        Zone::Hand
+    );
+}
