+/// CR 702.49a/d + CR 613.1f: hand-zone keyword grants install keywords,
+/// so synthesize their activation markers live. Subtract existing markers by
+/// variant and cost, one occurrence at a time, to preserve printed slots.
+fn runtime_granted_ninjutsu_abilities(
+    state: &GameState,
+    source_id: ObjectId,
+) -> Vec<AbilityDefinition> {
+    let Some(obj) = state.objects.get(&source_id) else {
+        return Vec::new();
+    };
+    if !matches!(obj.zone, Zone::Hand | Zone::Command) {
+        return Vec::new();
+    }
+    let mut unconsumed_printed: Vec<&AbilityCost> = obj
+        .abilities
+        .iter()
+        .filter_map(|ability| ability.cost.as_ref())
+        .filter(|cost| matches!(cost, AbilityCost::NinjutsuFamily { .. }))
+        .collect();
+    obj.keywords
+        .iter()
+        .filter_map(crate::database::synthesis::ninjutsu_ability_for_keyword)
+        .filter(|ability| {
+            if let Some(index) = unconsumed_printed
+                .iter()
+                .position(|cost| Some(*cost) == ability.cost.as_ref())
+            {
+                unconsumed_printed.remove(index);
+                return false;
+            }
+            true
+        })
+        .collect()
+}
