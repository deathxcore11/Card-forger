+#[test]
+fn opponent_can_stifle_ninjutsu_without_refunding_paid_costs() {
+    let mut fixture = setup(NinjutsuVariant::Ninjutsu, false);
+    let ability = announce(&mut fixture);
+    fixture
+        .runner
+        .act(GameAction::PassPriority)
+        .expect("give defender priority");
+    drop(
+        fixture
+            .runner
+            .cast(fixture.stifle)
+            .target_object(ability)
+            .commit(),
+    );
+    assert_eq!(
+        fixture.runner.state().stack.len(),
+        2,
+        "real Stifle response sits above ninjutsu"
+    );
+    fixture.runner.pass_both_players();
+    assert!(fixture.runner.state().stack.is_empty());
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.ninja].zone,
+        Zone::Hand
+    );
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.attacker].zone,
+        Zone::Hand
+    );
+    assert_eq!(fixture.runner.state().players[0].mana_pool.total(), 0);
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.stifle].zone,
+        Zone::Graveyard
+    );
+    assert!(!fixture
+        .runner
+        .state()
+        .holds_stack_bound_reveal(fixture.ninja));
+}
