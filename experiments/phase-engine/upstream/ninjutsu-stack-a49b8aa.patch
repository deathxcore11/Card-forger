+#[test]
+fn ninjutsu_has_a_paid_response_window_and_resumes_from_saved_state() {
+    for (variant, command, origin) in [
+        (NinjutsuVariant::Ninjutsu, false, Zone::Hand),
+        (NinjutsuVariant::CommanderNinjutsu, true, Zone::Command),
+    ] {
+        let mut fixture = setup(variant, command);
+        let ability = announce(&mut fixture);
+        let expected_label = match variant {
+            NinjutsuVariant::Ninjutsu => "Ninjutsu",
+            NinjutsuVariant::CommanderNinjutsu => "Commander ninjutsu",
+        };
+        for viewer in [P0, P1] {
+            let state = fixture.runner.state();
+            let filtered = filter_state_for_viewer(state, viewer);
+            let views = derive_filtered_views(state, &filtered, Some(viewer));
+            let details = views
+                .stack_entry_details
+                .get(&ability)
+                .expect("paid ninjutsu is visible on the stack to both players");
+            assert_eq!(details.kind_label, expected_label);
+            assert!(
+                details.targets.is_empty(),
+                "neither the returned creature nor its planeswalker defender is a target"
+            );
+        }
+        assert_eq!(fixture.runner.state().objects[&fixture.ninja].zone, origin);
+        fixture
+            .runner
+            .act(GameAction::PassPriority)
+            .expect("activator passes");
+        assert_eq!(
+            fixture.runner.state().waiting_for,
+            WaitingFor::Priority { player: P1 }
+        );
+        let encoded = serde_json::to_vec(fixture.runner.state()).expect("save pending ability");
+        let restored: GameState =
+            serde_json::from_slice(&encoded).expect("restore pending ability");
+        assert_eq!(restored.stack, fixture.runner.state().stack);
+        assert!(restored.holds_stack_bound_reveal(fixture.ninja));
+        let mut restored = GameRunner::from_state(restored);
+        for runner in [&mut fixture.runner, &mut restored] {
+            let result = runner
+                .act(GameAction::PassPriority)
+                .expect("defender passes; ability resolves");
+            assert!(
+                !result
+                    .events
+                    .iter()
+                    .any(|event| matches!(event, GameEvent::NinjutsuActivated { .. })),
+                "resolution must not activate again"
+            );
+            let ninja = &runner.state().objects[&fixture.ninja];
+            assert_eq!(ninja.zone, Zone::Battlefield);
+            assert!(ninja.tapped);
+            assert!(!runner.state().holds_stack_bound_reveal(fixture.ninja));
+            let attacker = runner
+                .state()
+                .combat
+                .as_ref()
+                .unwrap()
+                .attackers
+                .iter()
+                .find(|a| a.object_id == fixture.ninja)
+                .expect("resolved ninja is attacking");
+            assert_eq!(
+                attacker.attack_target,
+                AttackTarget::Planeswalker(fixture.defender)
+            );
+            assert_eq!(attacker.defending_player, P1);
+            assert!(runner.state().stack.is_empty());
+            assert!(runner.state().resolving_stack_entry.is_none());
+        }
+    }
+}
