+//! Paid ninjutsu announcements use the real stack and survive saved-state restore.
+
+use engine::game::combat::{AttackTarget, AttackerInfo, CombatState};
+use engine::game::derived_views::derive_filtered_views;
+use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
+use engine::game::scenario_db::GameScenarioDbExt;
+use engine::game::visibility::filter_state_for_viewer;
+use engine::game::zones::move_to_zone;
+use engine::types::ability::{AbilityCost, KeywordAction, NinjutsuVariant};
+use engine::types::actions::GameAction;
+use engine::types::events::{ActivatedAbilityKind, BoundActivationCost, GameEvent};
+use engine::types::game_state::{GameState, PriorityPassingMode, StackEntryKind, WaitingFor};
+use engine::types::identifiers::{ObjectId, ObjectIncarnationRef};
+use engine::types::keywords::Keyword;
+use engine::types::mana::{ManaCost, ManaCostShard, ManaType, ManaUnit};
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+// Verbatim MTGJSON Oracle text, also used by the existing card regressions.
+const NINJA: &str = "Ninjutsu {1}{U} ({1}{U}, Return an unblocked attacker you control to hand: Put this card onto the battlefield from your hand tapped and attacking.)\nWhenever this creature deals combat damage to a player, you may draw a card.";
+const YURIKO: &str = "Commander ninjutsu {U}{B} ({U}{B}, Return an unblocked attacker you control to hand: Put this card onto the battlefield from your hand or the command zone tapped and attacking.)\nWhenever a Ninja you control deals combat damage to a player, reveal the top card of your library and put that card into your hand. Each opponent loses life equal to that card's mana value.";
+const STIFLE: &str =
+    "Counter target activated or triggered ability. (Mana abilities can't be targeted.)";
+const FAVOR: &str = "Spree (Choose one or more additional costs.)\n+ {1} — Copy target instant spell, sorcery spell, activated ability, or triggered ability. You may choose new targets for the copy.\n+ {1} — Change the target of target spell or ability with a single target.";
+const RINGS: &str = "Whenever you activate an ability, if it isn't a mana ability, you may pay {2}. If you do, copy that ability. You may choose new targets for the copy.";
+
+struct Fixture {
+    runner: GameRunner,
+    attacker: ObjectId,
+    ninja: ObjectId,
+    stifle: ObjectId,
+    favor: ObjectId,
+    defender: ObjectId,
+    rings: Option<ObjectId>,
+}
+
+fn setup(variant: NinjutsuVariant, command: bool) -> Fixture {
+    setup_with_rings(variant, command, false)
+}
+
+fn setup_with_rings(variant: NinjutsuVariant, command: bool, include_rings: bool) -> Fixture {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::DeclareBlockers);
+    let attacker = scenario.add_creature(P0, "Grizzly Bears", 2, 2).id();
+    let (name, oracle, power, toughness) = match variant {
+        NinjutsuVariant::Ninjutsu => ("Ninja of the Deep Hours", NINJA, 2, 2),
+        NinjutsuVariant::CommanderNinjutsu => ("Yuriko, the Tiger's Shadow", YURIKO, 1, 3),
+    };
+    let ninja = scenario
+        .add_creature_to_hand_from_oracle(P0, name, power, toughness, oracle)
+        .id();
+    let stifle = scenario
+        .add_spell_to_hand_from_oracle(P1, "Stifle", true, STIFLE)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::Blue],
+            generic: 0,
+        })
+        .id();
+    let favor = scenario
+        .add_spell_to_hand_from_oracle(P1, "Return the Favor", true, FAVOR)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::Red, ManaCostShard::Red],
+            generic: 0,
+        })
+        .id();
+    let defender = scenario
+        .add_planeswalker_from_oracle(P1, "Combat recipient", "Test", 8, "")
+        .id();
+    let rings = include_rings.then(|| {
+        scenario
+            .add_artifact_from_oracle(P0, "Rings of Brighthearth", RINGS)
+            .id()
+    });
+    let mut runner = scenario.build();
+    if command {
+        move_to_zone(runner.state_mut(), ninja, Zone::Command, &mut vec![]);
+    }
+    let state = runner.state_mut();
+    if matches!(variant, NinjutsuVariant::CommanderNinjutsu) {
+        state.objects.get_mut(&ninja).unwrap().is_commander = true;
+    }
+    let mut attack = AttackerInfo::attacking_player(attacker, P1);
+    attack.attack_target = AttackTarget::Planeswalker(defender);
+    let mut combat = CombatState {
+        attackers: vec![attack],
+        ..Default::default()
+    };
+    combat.attacked_permanents.insert(
+        attacker,
+        ObjectIncarnationRef::from_object(&state.objects[&defender]),
+    );
+    state.combat = Some(combat);
+    state.waiting_for = WaitingFor::Priority { player: P0 };
+    state.priority_player = P0;
+    for player in [P0, P1] {
+        state
+            .priority_passing_modes
+            .insert(player, PriorityPassingMode::FullControl);
+    }
+    for color in [
+        ManaType::Blue,
+        match variant {
+            NinjutsuVariant::Ninjutsu => ManaType::Colorless,
+            NinjutsuVariant::CommanderNinjutsu => ManaType::Black,
+        },
+    ] {
+        let _ = state.add_mana_to_pool(P0, ManaUnit::new(color, attacker, false, vec![]));
+    }
+    for color in [ManaType::Blue, ManaType::Red, ManaType::Red, ManaType::Red] {
+        let _ = state.add_mana_to_pool(P1, ManaUnit::new(color, defender, false, vec![]));
+    }
+    Fixture {
+        runner,
+        attacker,
+        ninja,
+        stifle,
+        favor,
+        defender,
+        rings,
+    }
+}
+
+fn announce(fixture: &mut Fixture) -> ObjectId {
+    let result = fixture
+        .runner
+        .act(GameAction::ActivateNinjutsu {
+            ninjutsu_object_id: fixture.ninja,
+            creature_to_return: fixture.attacker,
+        })
+        .expect("announce the printed ninjutsu ability");
+    assert_eq!(
+        fixture.runner.state().objects[&fixture.attacker].zone,
+        Zone::Hand
+    );
+    assert_eq!(fixture.runner.state().players[0].mana_pool.total(), 0);
+    assert_eq!(
+        fixture.runner.state().stack.len(),
+        1,
+        "paid ability must await responses"
+    );
+    let entry = fixture.runner.state().stack.back().unwrap();
+    assert!(matches!(
+        entry.kind,
+        StackEntryKind::KeywordAction {
+            action: KeywordAction::Ninjutsu { .. }
+        }
+    ));
+    assert_eq!(result.events.iter().filter(|event| matches!(event,
+        GameEvent::AbilityActivated {
+            player_id: P0,
+            source_id,
+            kind: ActivatedAbilityKind::Normal,
+            stack_entry: Some(activated_entry),
+            activation_cost: BoundActivationCost::Cost(cost),
+            ..
+        } if *source_id == fixture.ninja && *activated_entry == entry.id
+            && matches!(cost.as_ref(), engine::types::ability::AbilityCost::NinjutsuFamily { .. })
+    )).count(), 1, "ordinary activation observers receive the exact paid stack entry");
+    assert!(fixture
+        .runner
+        .state()
+        .holds_stack_bound_reveal(fixture.ninja));
+    assert_eq!(result.events.iter().filter(|event| matches!(event, GameEvent::NinjutsuActivated { source_id, .. } if *source_id == fixture.ninja)).count(), 1, "activation event belongs to announcement");
+    entry.id
+}
