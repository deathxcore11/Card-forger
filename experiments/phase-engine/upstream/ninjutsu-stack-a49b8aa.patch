+#[test]
+fn ninjutsu_does_not_attack_a_new_incarnation_of_the_original_defender() {
+    for defender_left_before_activation in [false, true] {
+        let mut fixture = setup(NinjutsuVariant::Ninjutsu, false);
+        let original =
+            ObjectIncarnationRef::from_object(&fixture.runner.state().objects[&fixture.defender]);
+        if !defender_left_before_activation {
+            announce(&mut fixture);
+        }
+        move_to_zone(
+            fixture.runner.state_mut(),
+            fixture.defender,
+            Zone::Graveyard,
+            &mut vec![],
+        );
+        move_to_zone(
+            fixture.runner.state_mut(),
+            fixture.defender,
+            Zone::Battlefield,
+            &mut vec![],
+        );
+        assert!(!original.is_current(fixture.runner.state()));
+        if defender_left_before_activation {
+            announce(&mut fixture);
+        }
+        fixture.runner.pass_both_players();
+        let ninja = &fixture.runner.state().objects[&fixture.ninja];
+        assert_eq!(ninja.zone, Zone::Battlefield);
+        assert!(ninja.tapped);
+        assert!(!fixture
+            .runner
+            .state()
+            .combat
+            .as_ref()
+            .unwrap()
+            .attackers
+            .iter()
+            .any(|a| a.object_id == fixture.ninja));
+    }
+}
