# Cloudflare static asset headers. The Android app (its own origin) streams music from the website,
# so the audio files answer any origin; they are public and never carry cookies.
/assets/audio/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

# This week's Forge rules data for the engine inside the Android app (it checks once per launch).
/forge-rules/*
  Cache-Control: public, max-age=3600
